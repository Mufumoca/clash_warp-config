# Reference only. Let fscarmen's script generate warp.conf and account data.
[Interface]
PrivateKey = REPLACE_WITH_WARP_PRIVATE_KEY
Address = 172.16.0.2/32
Address = REPLACE_WITH_WARP_IPV6/128
DNS = 1.1.1.1,8.8.8.8,8.8.4.4,2606:4700:4700::1111,2001:4860:4860::8888,2001:4860:4860::8844
MTU = 1400
PostUp = ip -4 rule add from 198.18.0.1 lookup main
PostDown = ip -4 rule delete from 198.18.0.1 lookup main
PostUp = ip -6 rule add from REPLACE_WITH_NATIVE_IPV6_PREFIX/64 lookup main
PostDown = ip -6 rule delete from REPLACE_WITH_NATIVE_IPV6_PREFIX/64 lookup main
PostUp = /etc/wireguard/keepalive.sh start
PostDown = /etc/wireguard/keepalive.sh stop

[Peer]
PublicKey = bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=
AllowedIPs = 0.0.0.0/0
Endpoint = engage.cloudflareclient.com:2408
PersistentKeepalive = 30
