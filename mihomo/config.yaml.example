mixed-port: 7890
allow-lan: false
bind-address: 127.0.0.1
mode: rule
log-level: info
ipv6: true

tun:
  enable: true
  stack: system
  device: Meta
  auto-route: true
  auto-redirect: false
  strict-route: false
  dns-hijack:
    - any:53
    - tcp://any:53
  route-exclude-address:
    - 'REPLACE_WITH_HINET_IPV6/128'
    - 'REPLACE_WITH_WARP_ENDPOINT_IPV6/128'

dns:
  enable: true
  listen: 127.0.0.1:1053
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-range6: 'fdfe:dcba:9876::1/64'
  fake-ip-filter-mode: rule
  fake-ip-filter:
    - DOMAIN-SUFFIX,anthropic.com,fake-ip
    - DOMAIN-SUFFIX,claude.ai,fake-ip
    - DOMAIN-SUFFIX,claude.com,fake-ip
    - DOMAIN-SUFFIX,clau.de,fake-ip
    - DOMAIN-SUFFIX,claudemcpclient.com,fake-ip
    - DOMAIN-SUFFIX,claudemcpcontent.com,fake-ip
    - DOMAIN-SUFFIX,claudeusercontent.com,fake-ip
    - DOMAIN,servd-anthropic-website.b-cdn.net,fake-ip
    - DOMAIN,anthropic.com.cdn.cloudflare.net,fake-ip
    - DOMAIN,anthropic.auth0.com,fake-ip
    - DOMAIN,anthropic-com.ghost.io,fake-ip
    - DOMAIN-SUFFIX,sentry.io,fake-ip
    - DOMAIN-SUFFIX,statsigapi.net,fake-ip
    - DOMAIN,browser-intake-us5-datadoghq.com,fake-ip
    - DOMAIN-KEYWORD,datadog,fake-ip
    - DOMAIN-KEYWORD,sift,fake-ip
    - DOMAIN-SUFFIX,intercom.io,fake-ip
    - DOMAIN-SUFFIX,intercomcdn.com,fake-ip
    - DOMAIN,cdn.usefathom.com,fake-ip
    - MATCH,real-ip
  nameserver:
    - 2606:4700:4700::1111
    - 1.1.1.1

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  sniff:
    TLS:
      ports: [443]
    HTTP:
      ports: [80, 8080-8880]
    QUIC:
      ports: [443]

proxies:
  - name: hinet
    type: vless
    server: 'REPLACE_WITH_HINET_IPV6'
    port: REPLACE_WITH_HINET_PORT
    uuid: 'REPLACE_WITH_HINET_UUID'
    udp: true
    flow: xtls-rprx-vision
    tls: true
    servername: REPLACE_WITH_REALITY_SERVERNAME
    client-fingerprint: chrome
    reality-opts:
      public-key: 'REPLACE_WITH_REALITY_PUBLIC_KEY'
      short-id: 'REPLACE_WITH_REALITY_SHORT_ID'

rules:
  - DOMAIN-SUFFIX,anthropic.com,hinet
  - DOMAIN-SUFFIX,claude.ai,hinet
  - DOMAIN-SUFFIX,claude.com,hinet
  - DOMAIN-SUFFIX,clau.de,hinet
  - DOMAIN-SUFFIX,claudemcpclient.com,hinet
  - DOMAIN-SUFFIX,claudemcpcontent.com,hinet
  - DOMAIN-SUFFIX,claudeusercontent.com,hinet
  # CDN and static assets
  - DOMAIN,servd-anthropic-website.b-cdn.net,hinet
  - DOMAIN,anthropic.com.cdn.cloudflare.net,hinet
  # Authentication and content
  - DOMAIN,anthropic.auth0.com,hinet
  - DOMAIN,anthropic-com.ghost.io,hinet
  # Shared telemetry services
  - DOMAIN-SUFFIX,sentry.io,hinet
  - DOMAIN-SUFFIX,statsigapi.net,hinet
  - DOMAIN,browser-intake-us5-datadoghq.com,hinet
  - DOMAIN-KEYWORD,datadog,hinet
  - DOMAIN-KEYWORD,sift,hinet
  # Shared support widgets
  - DOMAIN-SUFFIX,intercom.io,hinet
  - DOMAIN-SUFFIX,intercomcdn.com,hinet
  - DOMAIN,cdn.usefathom.com,hinet
  # Address fallbacks
  - IP-CIDR,160.79.104.0/21,hinet,no-resolve
  - IP-CIDR6,2607:6bc0::/32,hinet,no-resolve
  - IP-ASN,399358,hinet,no-resolve
  - MATCH,DIRECT
